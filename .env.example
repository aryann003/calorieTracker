# Copy to mysite/.env for local development. Never commit .env.

SECRET_KEY=replace-this-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use a local SQLite file; set for PostgreSQL (e.g. Neon).
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# "Today" is the user's calendar day. Default: Asia/Kolkata
# TIME_ZONE=Asia/Kolkata
